#!/usr/bin/env bash

# shellcheck disable=SC2155

set -euo pipefail

readonly COMMIT_MSG_FILE="${1:?Usage: ${0##*/} <commit_msg_file> [source] [commit_sha]}"
readonly SIGNOFF_IDENT="$(git var GIT_COMMITTER_IDENT | sed -E 's/ [0-9]+ [-+][0-9]{4}$//')"

git interpret-trailers \
	--in-place \
	--if-exists doNothing \
	--trailer "Signed-off-by: ${SIGNOFF_IDENT}" \
	"$COMMIT_MSG_FILE"
